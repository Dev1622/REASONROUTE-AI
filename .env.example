GEMINI_API_KEY=your_gemini_api_key
VITE_GEMINI_API_KEY=your_gemini_api_key

# Routing provider selection:
# - leave ROUTING_PROVIDER unset to auto-use Mapbox when a token exists, otherwise OSRM
# - set ROUTING_PROVIDER=osrm to force free-road routing without traffic
# - set ROUTING_PROVIDER=mapbox to force traffic-aware routing
ROUTING_PROVIDER=mapbox

# Mapbox traffic routing
MAPBOX_ACCESS_TOKEN=your_mapbox_access_token
MAPBOX_DIRECTIONS_PROFILE=mapbox/driving-traffic

# Optional for shadow-pilot replays on historical routes
# Example: 2026-04-01T12:30:00Z
MAPBOX_DEPART_AT=
